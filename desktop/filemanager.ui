  <property name="styleSheet">
   <string notr="true">/* =========================================
   1. 全局设置
   ========================================= */
QWidget {
    /* 默认字体 */
    font-family: &quot;Microsoft YaHei&quot;;
}

/* =========================================
   2. 左侧菜单栏 (Sidebar) - 制造“阴影感”
   ========================================= */
#sideBar {
    /* 【关键】背景设为浅灰色，与右边的白色区分开 */
    background-color: #F2F2F7; 

    /* 【关键】右边加一条深灰色的线，这是制造“层级感”的核心 */
    border: none;
    border-right: 1px solid #D1D1D6; 
    
    /* 去掉选中时的虚线框 */
    outline: none;
    
    /* 让列表内容不要贴顶，留点呼吸感 */
    padding-top: 20px;
}

/* 侧边栏的每一个选项 (未选中) */
#sideBar::item {
    height: 50px;            /* 每一行的高度 */
    color: #484848;          /* 文字深灰 */
    margin: 5px 15px;        /* 【关键】左右留出空隙，让选项像悬浮的按钮 */
    border-radius: 8px;      /* 圆角 */
    border: none;
}

QListWidget::item:selected { 
    background-color: #dedede; 
    color: #E95420;             /* Ubuntu 标志性的橙色文字 */
    border-left: 4px solid #E95420; /* 左侧橙色竖条指示器 */
}

</string>
