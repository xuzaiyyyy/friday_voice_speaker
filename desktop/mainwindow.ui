    <widget class="QPushButton" name="btn_photo">
     <property name="geometry">
      <rect>
       <x>40</x>
       <y>50</y>
       <width>80</width>
       <height>80</height>
      </rect>
     </property>
     <property name="styleSheet">
      <string notr="true">#btn_photo {
    /* 1. 恢复磨砂透明感 */
    background-color: rgba(255, 255, 255, 80); 
    border: 1px solid rgba(255, 255, 255, 120);
    border-radius: 20px;

    /* 2. 使用 border-image，但配合 padding 来强制缩小图片 */
    border-image: url(:/pic/photo_app_icon.png) 0 0 0 0 stretch stretch;
    
    /* 核心参数：通过增加 padding，让图片缩在中间，不盖住边缘的透明区域 */
    /* 数值越大，图片越小，周围露出的透明底色就越多 */
    padding: 12px; 
}

#btn_photo:hover {
    background-color: rgba(255, 255, 255, 150);
}</string>
     </property>
     <property name="text">
      <string/>
     </property>
    </widget>
