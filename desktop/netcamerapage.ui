    <property name="styleSheet">
     <string notr="true">/* === 断开按钮 (红色) === */
QPushButton#btnDisconnect {
    background-color: #FF3B30; /* 正常状态：红 */
    border: 1px solid #FF3B30;
}

/* 🖱️ 悬停状态 (发光/变亮) */
QPushButton#btnDisconnect:hover {
    background-color: #FF6666; /* 🚨 改亮一点，这就是你要的发光感 */
    border: 1px solid #FF8888; /* 边框也跟着亮 */
}

/* 🚫 禁用状态 (关键修复！) */
/* 只有当它被禁用时，强制变灰，防止误解 */
QPushButton#btnDisconnect:disabled {
    background-color: #333333; /* 深灰 */
    border: 1px solid #555555;
    color: #777777;
}</string>
