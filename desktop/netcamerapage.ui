  <property name="styleSheet">
   <string notr="true">/* === 1. 全局基础设置 === */
QWidget {
    background-color: #1E1E24; /* 深蓝灰背景 */
    color: #E0E6ED;            /* 浅色文字 */
    font-family: &quot;Microsoft YaHei&quot;, &quot;Segoe UI&quot;;
    font-size: 14px;
}

/* === 2. 顶部 &amp; 底部栏 (容器背景色) === */
QFrame#frameTop, QFrame#frameBottom {
    background-color: #2B2D42; /* 稍微亮一点的深色，区分层次 */
    border: none;
}
QFrame#frameTop {
    border-bottom: 1px solid #3E4C59;
}
QFrame#frameBottom {
    border-top: 1px solid #3E4C59;
}

/* === 3. 【核心修改】输入框 (白底黑字) === */
QLineEdit {
    background-color: #FFFFFF;  /* 纯白背景 */
    color: #333333;             /* 深灰文字 (在白底上必须用深色字才看得清) */
    border: 1px solid #888888;  /* 灰色边框 */
    border-radius: 4px;
    padding: 4px 8px;
    font-weight: bold;
}
QLineEdit:focus {
    border: 2px solid #007AFF;  /* 选中时边框变蓝 */
}

/* === 4. 【核心修改】普通标签 (透明背景) === */
/* 注意：这里不包含 objectName 为 lblDisplay 的控件 */
QLabel {
    background-color: transparent; /* 去掉背景色 */
    border: none;                  /* 去掉边框 */
    color: #DDDDDD;                /* 文字颜色 */
	font-size: 20px;
}

/* === 5. 特例：视频显示区 (必须是黑底) === */
/* 使用 ID 选择器 #lblDisplay 覆盖上面的通用设置 */
QLabel#lblDisplay {
    background-color: #000000;
    border: 2px solid #3A405A;
    border-radius: 8px;
    color: #666; /* &quot;NO SIGNAL&quot; 的颜色 */
}

/* === 6. 按钮样式 === */
QPushButton {
    background-color: #454E5F;
    border: none;
    border-radius: 6px;
    padding: 6px 15px;
    color: white;
    font-weight: 600;

	text-align: center;
}
QPushButton:hover {
    background-color: #566275;
}
QPushButton:pressed {
    background-color: #2E3440;
    padding-top: 7px; /* 按下微动效果 */
}

/* 连接按钮 (蓝) */
QPushButton#btnConnect {
    background-color: #007AFF;
	font-size: 16px;
}
QPushButton#btnConnect:hover {
    background-color: #0062CC;
	font-size: 16px;
}

/* 断开按钮 (红) */
QPushButton#btnDisconnect {
    background-color: #FF3B30;
	font-size: 16px;
}
QPushButton#btnDisconnect:hover {
    background-color: #D32F2F;
	font-size: 16px;
}</string>
  </property>
