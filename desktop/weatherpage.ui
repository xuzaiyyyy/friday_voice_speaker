  <property name="styleSheet">
   <string notr="true">/* === 底部圆形按钮终极修复版 === */
QPushButton#btnLocation, QPushButton#btnBack {
    /* 1. 【形状修复】强制变成 50x50 的正圆 */
    min-width: 50px;
    max-width: 50px;
    min-height: 50px;
    max-height: 50px;
    border-radius: 25px; /* 半径必须是边长的一半 */

    /* 2. 【边框修复】去掉丑陋的默认边框，加一个极细的玻璃边框(可选) */
    border: none; 
    background-color: rgba(255, 255, 255, 30); /* 玻璃背景 */

    /* 3. 【图标大小修复】关键！ */
    /* padding: 0px 表示不留空隙，让图标尽可能大 */
    padding: 0px; 
    
    /* 也可以用负值稍微放大一点点，但 0px 通常足够了 */
    /* 确保图片居中且缩放 */
    background-repeat: no-repeat;
    background-position: center;
}

/* === 分别设置图片 (使用 image 属性，不要用 background-image) === */
/* image 属性会自动缩放图片来适应按钮大小 */
QPushButton#btnLocation {
    image: url(:/pic/weatherselect.png);
}

QPushButton#btnBack {
    image: url(:/pic/backweather.png);
}

/* === 鼠标交互效果 === */
QPushButton#btnLocation:hover, QPushButton#btnBack:hover {
    background-color: rgba(255, 255, 255, 60); /* 悬停变亮 */
}
QPushButton#btnLocation:pressed, QPushButton#btnBack:pressed {
    background-color: rgba(255, 255, 255, 20); /* 按下变暗 */
    padding: 4px; /* 按下时图标稍微缩小，产生按压感 */
}</string>
  </property>
